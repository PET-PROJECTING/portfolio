# Read-write token for the private Vercel Blob store.
# Local: copy this file to .env.local and paste the token there. .env.local stays uncommitted.
# Production: set the same variables on the Vercel project.
BLOB_READ_WRITE_TOKEN=

# Pathname of the PDF inside the Blob store. Change this to serve a different file.
RESUME_BLOB_PATHNAME="Oleh Klym Full-Stack Software Engineer.pdf"

# Inbox used by the "Get in touch" mailto link on the homepage.
CONTACT_EMAIL=

# Profile URLs for the contact footer.
LINKEDIN_URL=
GITHUB_URL=
